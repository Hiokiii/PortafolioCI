Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # InfinityFree requires application files inside htdocs: block private paths.
    RewriteRule ^(?:app|vendor|writable|tests|node_modules|dompdf|deploy|dist|\.git)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(?:sql|log|ini|bak|lock)$ - [F,L,NC]
    RewriteRule ^(?:composer\.json|package\.json|README\.md|spark|preload\.php|builds)$ - [F,L,NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "POST"
    Header always set Access-Control-Allow-Headers "Authorization, Content-Type"
</IfModule>
